# Copy to .env (git-ignored) and fill in. NEVER commit .env. This file must keep EMPTY / placeholder values only.
# Advanced challenge LLM (DeepSeek, OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: USD per 1M tokens, only to estimate cost in reports (look up current prices yourself; leave empty to skip)
DEEPSEEK_PRICE_IN_PER_M=
DEEPSEEK_PRICE_OUT_PER_M=
